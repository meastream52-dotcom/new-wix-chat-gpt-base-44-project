{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install",
  "env": {
    "DATABASE_URL": "@builderai-database-url",
    "ANTHROPIC_API_KEY": "@builderai-anthropic-key",
    "NEXTAUTH_SECRET": "@builderai-nextauth-secret",
    "NEXTAUTH_URL": "@builderai-nextauth-url",
    "GITHUB_TOKEN": "@builderai-github-token",
    "STRIPE_SECRET_KEY": "@builderai-stripe-secret",
    "STRIPE_WEBHOOK_SECRET": "@builderai-stripe-webhook-secret",
    "STRIPE_PRO_MONTHLY_PRICE_ID": "@builderai-stripe-pro-price",
    "STRIPE_ENTERPRISE_MONTHLY_PRICE_ID": "@builderai-stripe-enterprise-price",
    "OPENAI_API_KEY": "@builderai-openai-key",
    "REDIS_URL": "@builderai-redis-url"
  },
  "regions": ["iad1"],
  "functions": {
    "src/app/api/builder/projects/[id]/orchestrate/route.ts": { "maxDuration": 300 },
    "src/app/api/builder/projects/[id]/logs/route.ts": { "maxDuration": 300 },
    "src/app/api/builder/billing/webhook/route.ts": { "maxDuration": 30 },
    "src/app/api/extract/route.ts": { "maxDuration": 60 },
    "src/app/api/judge/route.ts":   { "maxDuration": 60 },
    "src/app/api/graph/route.ts":   { "maxDuration": 60 },
    "src/app/api/theory/route.ts":  { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PATCH,DELETE,OPTIONS" }
      ]
    }
  ]
}
