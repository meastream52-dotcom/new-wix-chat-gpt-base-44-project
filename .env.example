# ─────────────────────────────────────────────
# Platform — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Database (PostgreSQL via Prisma) ──────────
DATABASE_URL="postgresql://user:password@localhost:5432/platform_dev"

# ── AI / LLM ──────────────────────────────────
OPENAI_API_KEY="sk-..."
# Model to use for agents. Default is gpt-4o.
OPENAI_MODEL="gpt-4o"

# ── Graph Database (Neo4j) ────────────────────
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# ── Job Queue (Redis) ─────────────────────────
REDIS_URL="redis://localhost:6379"

# ── File Storage (AWS S3) ─────────────────────
# Required only when uploading document files.
# Leave blank to run in text-only mode.
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
S3_BUCKET="platform-documents"

# ── Auth (Auth.js v5 / NextAuth) ─────────────
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
# Also accepted as NEXTAUTH_SECRET for backwards compatibility.

# The public URL of this app. Auth.js uses this for OAuth callback URLs.
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth ──────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── App ───────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
