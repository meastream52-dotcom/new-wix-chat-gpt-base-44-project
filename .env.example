# PostgreSQL (Neon in prod, docker-compose locally)
DATABASE_URL="postgresql://echoblog:echoblog@localhost:5432/echoblog"

# Clerk — leave both empty to run in dev-auth mode (cookie-based demo users)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Stripe (Phase 2+) — leave empty to disable billing locally
STRIPE_SECRET_KEY=""
STRIPE_PREMIUM_PRICE_ID=""
# Signing secret for the billing webhook endpoint (/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=""
# Separate signing secret for the Connect webhook endpoint (/api/webhooks/stripe-connect)
STRIPE_CONNECT_WEBHOOK_SECRET=""

# Upstash/any Redis — optional assist layer for rate limiting (DB is the enforcement layer)
REDIS_URL=""

# Salt for IP / user-agent hashing on engagement rows
ENGAGEMENT_HASH_SALT="change-me"

# Shared secret for cron job endpoints (/api/cron/*)
CRON_SECRET="change-me"

# Base URL used in Stripe redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
