# ─────────────────────────────────────────────
# Ocean Label + Evidence AI — Environment Variables
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ocean_label"

# ── LLM (Phase 1: DeepSeek for chat widget and blog) ──
# DeepSeek (preferred for cost — ~1/7th the price of GPT-4o)
DEEPSEEK_API_KEY="sk-..."

# OpenAI (fallback or for customer-facing chat if higher quality needed)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ── Email (Postmark — for quote + contact form notifications) ──
POSTMARK_TOKEN="your-postmark-server-token"
POSTMARK_FROM_EMAIL="noreply@oceanlabel.com"
QUOTE_NOTIFICATION_EMAIL="info@oceanlabel.com"
CONTACT_NOTIFICATION_EMAIL="info@oceanlabel.com"

# ── SMS (Twilio — for contact form SMS alert to Dennis) ──
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_FROM_NUMBER="+19255550100"
OWNER_PHONE_NUMBER="+19254432883"

# ── AWS S3 (artwork/file upload storage) ──────
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-west-1"
S3_BUCKET="ocean-label-artwork"

# ── Retell AI (Phase 2: inbound voice receptionist) ──
# RETELL_API_KEY="key_..."
# RETELL_AGENT_ID="agent_..."

# ── Voice / Phone ──────────────────────────────
# VOICE_PHONE_NUMBER="+19255550100"

# ── LiteLLM (Phase 2: unified LLM gateway) ───
# LITELLM_MASTER_KEY="sk-..."
# LITELLM_BASE_URL="http://localhost:4000"

# ── Evidence AI (original platform — optional) ──
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
REDIS_URL="redis://localhost:6379"

# ── App ────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"
