# ─── Autonomous Software Company (ASC) ───────────────────────────────────────

# Anthropic (primary LLM for ASC agents)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ─── Evidence AI (existing) ───────────────────────────────────────────────────

# Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/evidence_ai"

# OpenAI (Evidence AI / optional ASC fallback)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Neo4j
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# Redis
REDIS_URL="redis://localhost:6379"

# AWS S3 (document storage)
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
S3_BUCKET="evidence-ai-documents"

# App
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
