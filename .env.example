# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (all agents) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override; defaults to claude-opus-4-8
ANTHROPIC_MODEL=claude-opus-4-8

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Slicer (optional, Phase 1 falls back to geometric estimates) ---
# Path to PrusaSlicer / OrcaSlicer CLI binary, e.g. /usr/bin/prusa-slicer
SLICER_CLI=

# --- OpenSCAD (optional, used by the Design Agent to render STL from .scad) ---
# Path to openscad binary, e.g. /usr/bin/openscad
OPENSCAD_PATH=
