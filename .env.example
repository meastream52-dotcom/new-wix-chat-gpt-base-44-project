# ─────────────────────────────────────────────
# Platform — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Database (PostgreSQL via Prisma) ──────────
DATABASE_URL="postgresql://user:password@localhost:5432/platform_dev"

# ── AI / LLM ──────────────────────────────────
OPENAI_API_KEY="sk-..."
# Model to use for agents. Default is gpt-4o.
OPENAI_MODEL="gpt-4o"

# ── Graph Database (Neo4j) ────────────────────
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# ── Job Queue (Redis) ─────────────────────────
REDIS_URL="redis://localhost:6379"

# ── File Storage (AWS S3) ─────────────────────
# Required only when uploading document files.
# Leave blank to run in text-only mode.
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
S3_BUCKET="platform-documents"

# ── Auth (NextAuth.js) ────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── App ───────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
