# Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/evidence_ai"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Neo4j
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# Redis
REDIS_URL="redis://localhost:6379"

# AWS S3 (document storage)
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
S3_BUCKET="evidence-ai-documents"

# App
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# =====================================================================
# Athlete Opportunity Engine (AOE) backend
# =====================================================================

# Supabase project (client + server). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Service role key — SERVER ONLY. Bypasses RLS (opportunity engine, admin,
# storage signing). Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage bucket for athlete video uploads (created in supabase/config.toml).
SUPABASE_VIDEO_BUCKET="athlete-videos"

# Distributed rate limiting (optional). When unset, an in-memory limiter is
# used (fine for local dev; use Upstash on Vercel for correctness across
# serverless instances).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
