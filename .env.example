# Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/evidence_ai"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Neo4j
NEO4J_URI="bolt://localhost:7687"
