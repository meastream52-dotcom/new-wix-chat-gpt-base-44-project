generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  source    String
  text      String
  s3Key     String?
  caseTag   String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claims    Claim[]
}

model Claim {
  id         String   @id @default(uuid())
  text       String
  confidence Float
  status     ClaimStatus @default(PENDING)
  timeRef    String?
  entities   String[]
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Theory {
  id          String   @id @default(uuid())
  title       String
  description String
  claimIds    String[]
  score       Float?
  scoreBreakdown Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contradiction {
  id          String   @id @default(uuid())
  claimAId    String
  claimBId    String
  reason      String
  severity    Float
  detectedAt  DateTime @default(now())
}

enum ClaimStatus {
  PENDING
  ACCEPTED
  WEAK
  REJECTED
}

// ─── Autonomous Software Company (ASC) models ───────────────────────────────

model AscProject {
  id          String           @id @default(uuid())
  name        String
  description String
  status      AscProjectStatus @default(INITIALIZING)
  customerId  String           @default("anonymous")
  tasks       AscTask[]
  artifacts   AscArtifact[]
  deployments AscDeployment[]
  costEntries AscCostEntry[]
  messages    AscMessage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model AscTask {
  id          String        @id @default(uuid())
  projectId   String
  project     AscProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRole   String
  type        String
  status      AscTaskStatus @default(PENDING)
  input       Json?
  output      Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
}

model AscArtifact {
  id        String          @id @default(uuid())
  projectId String
  project   AscProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      AscArtifactType
  name      String
  content   String
  version   Int             @default(1)
  createdAt DateTime        @default(now())
}

model AscDeployment {
  id          String              @id @default(uuid())
  projectId   String
  project     AscProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment String
  url         String?
  status      AscDeploymentStatus @default(PENDING)
  logs        String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model AscMessage {
  id            String         @id @default(uuid())
  projectId     String
  project       AscProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromAgentRole String
  toAgentRole   String?
  content       String
  type          AscMessageType @default(INFO)
  timestamp     DateTime       @default(now())
}

model AscCostEntry {
  id        String     @id @default(uuid())
  projectId String
  project   AscProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRole String
  tokens    Int
  cost      Float
  timestamp DateTime   @default(now())
}

enum AscProjectStatus {
  INITIALIZING
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}

enum AscTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum AscArtifactType {
  PRD
  ARCHITECTURE
  FRONTEND_CODE
  BACKEND_CODE
  DATABASE_SCHEMA
  TESTS
  DOCUMENTATION
  DEPLOYMENT_CONFIG
}

enum AscDeploymentStatus {
  PENDING
  BUILDING
  DEPLOYED
  FAILED
}

enum AscMessageType {
  INFO
  SUCCESS
  ERROR
  WARNING
  PROGRESS
}
