generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  source    String
  text      String
  s3Key     String?
  caseTag   String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claims    Claim[]
}

model Claim {
  id         String   @id @default(uuid())
  text       String
  confidence Float
  status     ClaimStatus @default(PENDING)
  timeRef    String?
  entities   String[]
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Theory {
  id          String   @id @default(uuid())
  title       String
  description String
  claimIds    String[]
  score       Float?
  scoreBreakdown Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contradiction {
  id          String   @id @default(uuid())
  claimAId    String
  claimBId    String
  reason      String
  severity    Float
  detectedAt  DateTime @default(now())
}

enum ClaimStatus {
  PENDING
  ACCEPTED
  WEAK
  REJECTED
}

model BlogUser {
  id            String        @id @default(uuid())
  email         String        @unique
  name          String
  password      String
  role          BlogUserRole  @default(MEMBER)
  avatar        String?
  bio           String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  posts         BlogPost[]
  subscription  BlogSubscription?
  sessions      BlogSession[]
}

model BlogSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      BlogUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model BlogCategory {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  color       String     @default("#E51C23")
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  posts       BlogPost[]
}

model BlogPost {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  excerpt       String?
  content       String         @db.Text
  featuredImage String?
  categoryId    String
  category      BlogCategory   @relation(fields: [categoryId], references: [id])
  authorId      String
  author        BlogUser       @relation(fields: [authorId], references: [id])
  status        BlogPostStatus @default(DRAFT)
  featured      Boolean        @default(false)
  views         Int            @default(0)
  tags          String[]
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model BlogSubscription {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  user             BlogUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             BlogSubscriptionPlan   @default(FREE)
  status           BlogSubscriptionStatus @default(ACTIVE)
  stripeCustomerId String?
  currentPeriodEnd DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model BlogAdUnit {
  id        String   @id @default(uuid())
  name      String
  placement String
  code      String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum BlogUserRole {
  ADMIN
  MEMBER
  SUBSCRIBER
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogSubscriptionPlan {
  FREE
  PREMIUM
  ANNUAL
}

enum BlogSubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}
