generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Legacy Evidence AI models ───────────────────────────────────────────────

model Document {
  id        String      @id @default(uuid())
  title     String
  source    String
  text      String
  s3Key     String?
  caseTag   String      @default("general")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  claims    Claim[]
}

model Claim {
  id         String   @id @default(uuid())
  text       String
  confidence Float
  status     String   @default("PENDING")
  timeRef    String?
  entities   String   @default("[]")
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Theory {
  id             String   @id @default(uuid())
  title          String
  description    String
  claimIds       String   @default("[]")
  score          Float?
  scoreBreakdown String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Contradiction {
  id         String   @id @default(uuid())
  claimAId   String
  claimBId   String
  reason     String
  severity   Float
  detectedAt DateTime @default(now())
}

// ─── Blog Platform models ─────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  password     String?
  image        String?
  role         String        @default("USER")
  subscription String?
  createdAt    DateTime      @default(now())
  posts        Post[]
  comments     Comment[]
}

model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String
  featuredImage String?
  published     Boolean   @default(false)
  featured      Boolean   @default(false)
  premium       Boolean   @default(false)
  views         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authorId   String
  author     User     @relation(fields: [authorId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  comments Comment[]
  tags     Tag[]
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  image       String?
  posts       Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  posts Post[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  postId String
  post   Post   @relation(fields: [postId], references: [id])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  stripeId  String
  status    String
  createdAt DateTime @default(now())
}

model AdUnit {
  id        String   @id @default(cuid())
  name      String
  placement String
  code      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

