generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  source    String
  text      String
  s3Key     String?
  caseTag   String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claims    Claim[]
}

model Claim {
  id         String   @id @default(uuid())
  text       String
  confidence Float
  status     ClaimStatus @default(PENDING)
  timeRef    String?
  entities   String[]
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Theory {
  id          String   @id @default(uuid())
  title       String
  description String
  claimIds    String[]
  score       Float?
  scoreBreakdown Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contradiction {
  id          String   @id @default(uuid())
  claimAId    String
  claimBId    String
  reason      String
  severity    Float
  detectedAt  DateTime @default(now())
}

enum ClaimStatus {
  PENDING
  ACCEPTED
  WEAK
  REJECTED
}

model Podcast {
  id           String        @id @default(uuid())
  title        String
  topic        String
  tone         String        @default("conversational")
  targetLength Int           @default(10)
  hostName     String        @default("Alex")
  voiceId      String        @default("21m00Tcm4TlvDq8ikWAM")
  status       PodcastStatus @default(DRAFT)
  script       Json?
  audioUrl     String?
  adsEnabled   Boolean       @default(true)
  adIds        String[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AdCampaign {
  id        String      @id @default(uuid())
  name      String
  sponsor   String
  adCopy    String
  placement AdPlacement @default(MID_ROLL)
  status    AdStatus    @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum PodcastStatus {
  DRAFT
  SCRIPTED
  GENERATING
  READY
  FAILED
}

enum AdPlacement {
  PRE_ROLL
  MID_ROLL
  POST_ROLL
}

enum AdStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}
