generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  source    String
  text      String
  s3Key     String?
  caseTag   String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claims    Claim[]
}

model Claim {
  id         String   @id @default(uuid())
  text       String
  confidence Float
  status     ClaimStatus @default(PENDING)
  timeRef    String?
  entities   String[]
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Theory {
  id          String   @id @default(uuid())
  title       String
  description String
  claimIds    String[]
  score       Float?
  scoreBreakdown Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contradiction {
  id          String   @id @default(uuid())
  claimAId    String
  claimBId    String
  reason      String
  severity    Float
  detectedAt  DateTime @default(now())
}

enum ClaimStatus {
  PENDING
  ACCEPTED
  WEAK
  REJECTED
}

// ── Auth models (Auth.js v5 + Prisma adapter) ────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Only set for users who signed up with email/password.
  // OAuth-only users have null here.
  password      String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Unused with JWT sessions but kept for potential future database-session strategy.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom model for password-reset flow.
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
