# Pre-filled for docker-compose.yml — copy to .env to use
DATABASE_URL="postgresql://evidence:evidence_secret@localhost:5432/evidence_ai"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="evidence_secret"
REDIS_URL="redis://localhost:6379"

# Fill these in:
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Optional — leave blank to skip S3 (text-only mode)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET="evidence-ai-documents"
